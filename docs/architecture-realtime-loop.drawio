        <mxCell id="legend-title" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Helvetica;labelBackgroundColor=none;" value="Real-time loop steps" vertex="1" parent="1">
          <mxGeometry height="30" width="460" x="1250" y="140" as="geometry" />
        </mxCell>
