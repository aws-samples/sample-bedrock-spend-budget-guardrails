        <mxCell id="legend-1-t" value="&lt;b&gt;Invoke&lt;/b&gt;&lt;div&gt;&lt;i&gt;Caller (IAM user/role, SSO, or Agent) calls InvokeModel / Converse on Amazon Bedrock.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="188" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-2-b" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="236" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-2-t" value="&lt;b&gt;Invocation log&lt;/b&gt;&lt;div&gt;&lt;i&gt;Bedrock writes token + dimension counts (no prompts) to CloudWatch Logs.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="234" width="396" height="46" as="geometry"/></mxCell>
