        <mxCell id="legend-6-t" value="&lt;b&gt;Stream&lt;/b&gt;&lt;div&gt;&lt;i&gt;The RunningSpend stream drives enforcement (and notify) on every update.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="418" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-7-b" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="466" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-7-t" value="&lt;b&gt;Deny&lt;/b&gt;&lt;div&gt;&lt;i&gt;On a breached deny-budget, an IAM bbg-deny-* policy attaches to the principal. Sub-30s p95.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="464" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-8-b" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="512" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-8-t" value="&lt;b&gt;Resolve discounts&lt;/b&gt;&lt;div&gt;&lt;i&gt;org-discount-resolver walks the Org tree (hourly + on-write) and materializes each account’s effective discount % onto its Pricing row.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="510" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-9-b" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="558" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-9-t" value="&lt;b&gt;Admin &amp; web&lt;/b&gt;&lt;div&gt;&lt;i&gt;Operators use the CloudFront SPA → HTTP API → per-route Lambdas to manage budgets, discounts, users, enrollment, and read spend/activity.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="556" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-10-b" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="604" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-10-t" value="&lt;b&gt;Cross-account ingest&lt;/b&gt;&lt;div&gt;&lt;i&gt;Member-account Bedrock calls → cwl-forwarder → PutEvents on the home bus → same meter. Spend appears in home RunningSpend &lt; 60s.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="602" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-11-b" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="650" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-11-t" value="&lt;b&gt;Cross-account enforce&lt;/b&gt;&lt;div&gt;&lt;i&gt;enforcement assumes the bbg-enforcement role in the member account and attaches the deny there; period-rollover detaches.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="648" width="396" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
