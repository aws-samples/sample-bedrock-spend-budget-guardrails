        <mxCell id="legend-5-t" value="&lt;b&gt;Add spend&lt;/b&gt;&lt;div&gt;&lt;i&gt;Idempotent ADD into the per-principal × per-target RunningSpend row (scaled by the effective discount).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="372" width="396" height="46" as="geometry"/></mxCell>
