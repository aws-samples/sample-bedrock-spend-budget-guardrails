        </mxCell>
        <mxCell id="step1-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step1-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step1-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;InvokeModel / Converse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Caller (IAM user/role/SSO/Agent) calls Bedrock — could be from this account or any enrolled member.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step1-l">
          <mxGeometry height="65" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step2-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="80" as="geometry" />
        </mxCell>
        <mxCell id="step2-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2a / 2b" vertex="1" parent="step2-l">
          <mxGeometry height="38" width="60" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step2-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Two streams in parallel&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Bedrock invocation logging writes requestId + token counts to CloudWatch Logs (2a). CloudTrail emits a Bedrock data event with requestId + userIdentity (2b).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step2-l">
          <mxGeometry height="80" width="388" x="72" as="geometry" />
        </mxCell>
        <mxCell id="step3-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="170" as="geometry" />
        </mxCell>
        <mxCell id="step3-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3a / 3b" vertex="1" parent="step3-l">
          <mxGeometry height="38" width="60" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step3-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Both consumers fire&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CWL subscription filter delivers to meter (3a). EventBridge rule on the data event delivers to identity-cache (3b).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step3-l">
          <mxGeometry height="80" width="388" x="72" as="geometry" />
        </mxCell>
        <mxCell id="step4-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="260" as="geometry" />
        </mxCell>
        <mxCell id="step4-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step4-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step4-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Identity canonicalize&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;identity-cache writes the canonical principal ARN to IdentityCache keyed by requestId. SSO and assumed-role variants normalize to a single key.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step4-l">
          <mxGeometry height="80" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step5-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="65" width="460" x="0" y="350" as="geometry" />
        </mxCell>
        <mxCell id="step5-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step5-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step5-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Multi-dim USD lookup&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;meter reads region rates from Pricing/InferenceProfiles (cached daily by pricing-refresher).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step5-l">
          <mxGeometry height="65" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step6-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="425" as="geometry" />
        </mxCell>
        <mxCell id="step6-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step6-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step6-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Idempotent ADD to RunningSpend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Atomic ADD into the per-principal x per-target row, guarded by a processedRequestIds set so retries don't double-count. On identity miss the meter writes a PendingMeter row instead.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step6-l">
          <mxGeometry height="80" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step7-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="515" as="geometry" />
        </mxCell>
        <mxCell id="step7-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="step7-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step7-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Late-arriving identity replay&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;If 3a beat 3b, identity-cache emits bbg.identity-arrived on a PendingMeter hit. EventBridge re-invokes meter to complete the join.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step7-l">
          <mxGeometry height="80" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step8-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="605" as="geometry" />
        </mxCell>
        <mxCell id="step8-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="step8-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step8-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Stream consumer evaluates&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;DDB stream fires on every RunningSpend modify. enforcement looks up Budgets[principal,target] (and the wildcard fallback).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step8-l">
          <mxGeometry height="80" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step9-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="80" width="460" x="0" y="695" as="geometry" />
        </mxCell>
        <mxCell id="step9-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="step9-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step9-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Attach bbg-deny-* policy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;When spend &gt; limit and the threshold is &quot;block&quot;, enforcement creates a deny policy targeting the model + profile ARNs, then attaches via iam:AttachUser/RolePolicy. Sub-30s p95 from invoke to attached.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step9-l">
          <mxGeometry height="80" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step10-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="65" width="460" x="0" y="785" as="geometry" />
        </mxCell>
        <mxCell id="step10-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="step10-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step10-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Period rollover&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;EventBridge schedule (monthly default; weekly / daily / 5h available) detaches deny policies and resets RunningSpend.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step10-l">
          <mxGeometry height="65" width="408" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step11-l" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="65" width="460" x="0" y="860" as="geometry" />
        </mxCell>
        <mxCell id="step11-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="11" vertex="1" parent="step11-l">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step11-d" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Ledger to S3 / Athena&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ledger-writer also consumes the DDB stream and lands JSONL on S3 for ad-hoc Athena reports.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step11-l">
          <mxGeometry height="65" width="408" x="52" as="geometry" />
        </mxCell>
      </root>
