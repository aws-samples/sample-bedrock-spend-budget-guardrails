{
  "name": "sample-bedrock-spend-budget-guardrails",
  "version": "1.3.1",
  "private": true,
  "description": "Near real-time per-IAM-principal × per-model Bedrock spend metering and budget enforcement.",
  "license": "MIT-0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "infra",
    "lambda",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "synth": "npm run synth -w @bbg/infra",
    "deploy:dev": "BBG_LOCAL=1 npm run -w @bbg/infra cdk -- deploy --hotswap-fallback 'DevAppStage/*' --require-approval never",
    "deploy:diff": "BBG_LOCAL=1 npm run -w @bbg/infra cdk -- diff 'DevAppStage/*'",
    "dev:web": "npm run -w @bbg/web dev",
    "dump-config": "npm run -w @bbg/web dump-config",
    "loadgen": "npm run -w @bbg/lambda loadgen",
    "seed:cognito": "npm run -w @bbg/lambda seed:cognito",
    "force-rollover": "npm run -w @bbg/lambda force-rollover",
    "docs:check": "node scripts/docs-check.mjs",
    "hooks:install": "git config core.hooksPath scripts/git-hooks"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
