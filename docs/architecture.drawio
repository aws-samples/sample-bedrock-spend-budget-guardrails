        <mxCell id="legend-3-t" value="&lt;b&gt;Identity&lt;/b&gt;&lt;div&gt;&lt;i&gt;CloudTrail records the caller identity + requestId onto the default EventBridge bus.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="280" width="396" height="46" as="geometry"/></mxCell>
        <mxCell id="legend-4-b" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1732" y="328" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="legend-4-t" value="&lt;b&gt;Join&lt;/b&gt;&lt;div&gt;&lt;i&gt;meter joins the log with the canonicalized identity on requestId and computes USD across all dimensions.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1768" y="326" width="396" height="46" as="geometry"/></mxCell>
